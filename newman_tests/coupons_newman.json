{
  "info": {
    "name": "coupons",
    "description": "API tests for the Ideal Trips coupons API (LocalStack). Run with: newman run newman_tests/coupons_newman.json --env-var api_id=<API ID>",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "api_id", "value": "" },
    { "key": "stage", "value": "local" },
    { "key": "base_url", "value": "http://{{api_id}}.execute-api.localhost.localstack.cloud:4566/{{stage}}" }
  ],
  "item": [
    {
      "name": "GET /coupons_poc",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response is JSON', function () {",
              "    pm.response.to.be.json;",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});",
              "",
              "pm.test('Response is a list of 3 coupons', function () {",
              "    const coupons = pm.response.json();",
              "    pm.expect(coupons).to.be.an('array').that.has.lengthOf(3);",
              "});",
              "",
              "pm.test('Each coupon has the expected fields', function () {",
              "    const fields = ['coupon_id', 'title', 'description', 'coupon_code', 'campaign_id', 'provider_id', 'provider_name', 'start_date', 'end_date'];",
              "    pm.response.json().forEach(function (coupon) {",
              "        pm.expect(coupon).to.have.all.keys(fields);",
              "    });",
              "});",
              "",
              "pm.test('Response matches the sample coupons', function () {",
              "    const coupons = pm.response.json();",
              "    pm.expect(coupons.map(c => c.coupon_code)).to.eql(['SAVE20', 'STAY10PLUS', 'TRAVEL10']);",
              "    pm.expect(coupons[0].coupon_id).to.eql('319326de971100158f6fa0daeec978fba1f17e4b');",
              "    pm.expect(coupons[0].provider_name).to.eql('Fairmont Hotels and Resorts');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{base_url}}/coupons_poc",
          "host": ["{{base_url}}"],
          "path": ["coupons_poc"]
        }
      },
      "response": []
    }
  ]
}
