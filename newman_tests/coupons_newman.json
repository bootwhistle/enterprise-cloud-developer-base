{
  "info": {
    "name": "coupons",
    "description": "API tests for the Ideal Trips coupons API (LocalStack). Run with: newman run newman_tests/coupons_newman.json --env-var api_id=<API ID>",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "api_id", "value": "" },
    { "key": "stage", "value": "local" },
    { "key": "base_url", "value": "http://{{api_id}}.execute-api.localhost.localstack.cloud:4566/{{stage}}" }
  ],
  "item": [
    {
      "name": "GET /coupons_poc",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response is JSON', function () {",
              "    pm.response.to.be.json;",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});",
              "",
              "pm.test('Response has a message property', function () {",
              "    pm.expect(pm.response.json()).to.have.property('message');",
              "});",
              "",
              "pm.test('Message confirms the API is working', function () {",
              "    pm.expect(pm.response.json()).to.eql({ message: 'Coupons API is working successfully' });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{base_url}}/coupons_poc",
          "host": ["{{base_url}}"],
          "path": ["coupons_poc"]
        }
      },
      "response": []
    }
  ]
}
