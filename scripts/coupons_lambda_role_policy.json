{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowCouponsCloudWatchLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:*:*:log-group:/aws/lambda/coupons*",
        "arn:aws:logs:*:*:log-group:/aws/lambda/coupons*:log-stream:*"
      ]
    }
  ]
}
